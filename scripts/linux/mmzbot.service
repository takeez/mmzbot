[Unit]
Description=MMZBOT QQ bot
After=network-online.target
Wants=network-online.target
# 崩溃退避上限，别一秒重启一次把机器拖死
StartLimitBurst=10
StartLimitIntervalSec=120

[Service]
Type=simple
# ⚠️ 这三处按自己的路径改（默认示例是 /opt/mmzbot + /var/lib/mmzbot）
User=mmzbot
Group=mmzbot
WorkingDirectory=/opt/mmzbot
Environment=MMZBOT_DATA=/var/lib/mmzbot
Environment=MMZBOT_TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
# ⚠ 2026-11-01：不直接写 python 路径了 —— run.sh 会自己选：
#   有 .venv 用 .venv/bin/python（装了语义记忆依赖），没有就 python3。
ExecStart=/opt/mmzbot/run.sh
Restart=always
RestartSec=5
StandardOutput=append:/var/log/mmzbot/stdout.log
StandardError=append:/var/log/mmzbot/stdout.log

# ── 沙箱：只让数据目录和日志目录可写 ──
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/mmzbot /var/log/mmzbot
# 再加几条（都是"只收紧、不放宽"的；万一你的机器上起不来，把下面这几行删掉即可）
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
